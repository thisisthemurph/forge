#!/usr/bin/env bash
# Manage a disposable GitHub repo for manual Forge CLI testing.
#
# Creates a private repo named exactly "forge-manual-test" with a parent Feature
# issue and example sub-issues. Refuses to create if that repo already exists.
# Delete only works when the repo name and description match the safety checks.
#
# Requires: gh (authenticated). Delete needs: gh auth refresh -s delete_repo
#
# Usage:
#   scripts/forge-test-repo create
#   scripts/forge-test-repo delete
#   scripts/forge-test-repo info

set -euo pipefail

readonly REPO_NAME='forge-manual-test'
readonly REPO_DESCRIPTION='Forge manual test — disposable repo for local forge CLI testing. Safe to delete with scripts/forge-test-repo delete.'
readonly STATE_FILE='.forge/manual-test-repo.env'

die() {
  echo "forge-test-repo: $*" >&2
  exit 1
}

require_gh() {
  command -v gh >/dev/null 2>&1 || die 'gh is not installed (https://cli.github.com/)'
  gh auth status >/dev/null 2>&1 || die 'gh is not authenticated; run: gh auth login'
}

repo_owner() {
  gh api user -q .login
}

repo_slug() {
  local owner
  owner="$(repo_owner)"
  printf '%s/%s' "$owner" "$REPO_NAME"
}

repo_exists() {
  local owner=$1
  gh repo view "${owner}/${REPO_NAME}" >/dev/null 2>&1
}

validate_deletable() {
  local owner=$1
  if [[ "$REPO_NAME" != 'forge-manual-test' ]]; then
    die "internal error: unexpected repo name ${REPO_NAME}"
  fi
  local desc
  desc="$(gh repo view "${owner}/${REPO_NAME}" --json description -q .description 2>/dev/null || true)"
  if [[ "$desc" != *'Forge manual test'* ]]; then
    die "refusing to delete ${owner}/${REPO_NAME}: description does not contain \"Forge manual test\""
  fi
}

issue_id() {
  local owner=$1 repo=$2 number=$3
  gh api "repos/${owner}/${repo}/issues/${number}" --jq .id
}

attach_sub_issue() {
  local owner=$1 repo=$2 parent_number=$3 child_id=$4
  # -f sends strings; GitHub requires sub_issue_id as a JSON integer.
  gh api -X POST "repos/${owner}/${repo}/issues/${parent_number}/sub_issues" \
    -F "sub_issue_id=${child_id}" >/dev/null
}

create_labeled_issue() {
  local owner=$1 repo=$2 title=$3 body=$4
  local url number
  url="$(gh issue create --repo "${owner}/${repo}" \
    --title "$title" \
    --body "$body" \
    --label ready-for-agent)"
  number="${url##*/}"
  printf '%s' "$number"
}

write_state() {
  local owner=$1 feature=$2 sub1=$3 sub2=$4 sub3=$5 sub4=$6 sub5=$7
  mkdir -p "$(dirname "$STATE_FILE")"
  cat >"$STATE_FILE" <<EOF
# Generated by scripts/forge-test-repo create. Do not commit.
FORGE_TEST_OWNER=${owner}
FORGE_TEST_REPO=${REPO_NAME}
FORGE_TEST_FEATURE=${feature}
FORGE_TEST_SUB_VERSION=${sub1}
FORGE_TEST_SUB_GREET=${sub2}
FORGE_TEST_SUB_MAKEFILE=${sub3}
FORGE_TEST_SUB_README=${sub4}
FORGE_TEST_SUB_TEST=${sub5}
EOF
}

read_state() {
  [[ -f "$STATE_FILE" ]] || die "no state file at ${STATE_FILE}; run create first or pass owner explicitly"
  # shellcheck disable=SC1090
  source "$STATE_FILE"
  [[ -n "${FORGE_TEST_OWNER:-}" && -n "${FORGE_TEST_REPO:-}" ]] || die "state file is incomplete"
}

cmd_create() {
  require_gh
  local owner
  owner="$(repo_owner)"

  if repo_exists "$owner"; then
    die "repository ${owner}/${REPO_NAME} already exists; run delete first or use a different GitHub account"
  fi

  echo "forge-test-repo: creating ${owner}/${REPO_NAME}..."
  gh repo create "$REPO_NAME" \
    --private \
    --description "$REPO_DESCRIPTION" \
    --add-readme >/dev/null

  # Labels used by forge skills / triage (optional for status; harmless if missing later).
  for label in ready-for-agent forge; do
    gh label create "$label" --repo "${owner}/${REPO_NAME}" --color "0E8A16" --force >/dev/null 2>&1 || true
  done

  local feature_body
  feature_body="$(cat <<'EOF'
Parent **Feature** for manual Forge testing.

Five sub-issues build a tiny greeter in this otherwise empty repo (README only):

1. `VERSION` file
2. `bin/greet` script
3. `Makefile` with a `greet` target
4. README usage section
5. `test/greet.sh` smoke test

Use this issue number with Forge:

```bash
forge status <feature-number> --repo OWNER/forge-manual-test
forge run <feature-number> --repo OWNER/forge-manual-test
```

Created by `scripts/forge-test-repo create`.
EOF
)"

  local feature_url feature_number
  feature_url="$(gh issue create --repo "${owner}/${REPO_NAME}" \
    --title 'Forge manual test: tiny greeter' \
    --body "$feature_body" \
    --label ready-for-agent)"
  feature_number="${feature_url##*/}"

  echo "forge-test-repo: creating sub-issues..."

  local sub_version sub_greet sub_makefile sub_readme sub_test
  local id_version id_greet id_makefile id_readme id_test

  sub_version="$(create_labeled_issue "$owner" "$REPO_NAME" \
    'Add VERSION file' \
    "$(cat <<'EOF'
Add a `VERSION` file at the repository root.

**Acceptance**
- File `VERSION` exists
- Contents are exactly: `0.1.0` (no trailing newline required, but no extra text)

No other files need to change in this step.
EOF
)")"
  id_version="$(issue_id "$owner" "$REPO_NAME" "$sub_version")"

  sub_greet="$(create_labeled_issue "$owner" "$REPO_NAME" \
    'Add bin/greet script' \
    "$(cat <<'EOF'
Add an executable shell script at `bin/greet`.

**Acceptance**
- `bin/greet` exists and is executable (`chmod +x`)
- Running `./bin/greet` prints exactly: `Hello, Forge manual test!`
- Script starts with `#!/usr/bin/env bash`

Do not add a Makefile or tests yet.
EOF
)")"
  id_greet="$(issue_id "$owner" "$REPO_NAME" "$sub_greet")"

  sub_makefile="$(create_labeled_issue "$owner" "$REPO_NAME" \
    'Add Makefile greet target' \
    "$(cat <<EOF
Add a \`Makefile\` with a \`greet\` target that runs the greet script.

## Blocked by
- #${sub_greet}

**Acceptance**
- \`Makefile\` exists at repo root
- \`make greet\` runs \`bin/greet\` and prints \`Hello, Forge manual test!\`
- Include a default target or \`.PHONY: greet\` as you prefer
EOF
)")"
  id_makefile="$(issue_id "$owner" "$REPO_NAME" "$sub_makefile")"

  sub_readme="$(create_labeled_issue "$owner" "$REPO_NAME" \
    'Document make greet in README' \
    "$(cat <<EOF
Extend the existing \`README.md\` with a **Usage** section for the greeter.

## Blocked by
- #${sub_makefile}

**Acceptance**
- README has a \`## Usage\` heading
- Documents running \`make greet\` and the expected one-line output
- Do not remove the existing README title or intro paragraph
EOF
)")"
  id_readme="$(issue_id "$owner" "$REPO_NAME" "$sub_readme")"

  sub_test="$(create_labeled_issue "$owner" "$REPO_NAME" \
    'Add greet smoke test' \
    "$(cat <<EOF
Add a minimal smoke test for the greet script.

## Blocked by
- #${sub_readme}

**Acceptance**
- \`test/greet.sh\` exists and is executable
- Running \`test/greet.sh\` exits 0 when \`bin/greet\` prints the expected line
- Test fails (non-zero exit) if output is wrong
- Use plain bash only (no extra test frameworks required)
EOF
)")"
  id_test="$(issue_id "$owner" "$REPO_NAME" "$sub_test")"

  echo "forge-test-repo: attaching sub-issues to feature #${feature_number}..."
  for id in "$id_version" "$id_greet" "$id_makefile" "$id_readme" "$id_test"; do
    attach_sub_issue "$owner" "$REPO_NAME" "$feature_number" "$id"
  done

  write_state "$owner" "$feature_number" \
    "$sub_version" "$sub_greet" "$sub_makefile" "$sub_readme" "$sub_test"

  cat <<EOF

Created ${owner}/${REPO_NAME}

  Feature:  #${feature_number}  Tiny greeter
  Step 1:   #${sub_version}  VERSION file
  Step 2:   #${sub_greet}  bin/greet
  Step 3:   #${sub_makefile}  Makefile (blocked by #${sub_greet})
  Step 4:   #${sub_readme}  README usage (blocked by #${sub_makefile})
  Step 5:   #${sub_test}  smoke test (blocked by #${sub_readme})

Clone and try Forge:

  git clone "https://github.com/${owner}/${REPO_NAME}.git"
  cd ${REPO_NAME}
  forge status ${feature_number} --repo ${owner}/${REPO_NAME}

State saved to ${STATE_FILE} (gitignored).

EOF
}

cmd_delete() {
  require_gh
  local owner="${1:-}"
  if [[ -z "$owner" ]]; then
    if [[ -f "$STATE_FILE" ]]; then
      read_state
      owner="$FORGE_TEST_OWNER"
    else
      owner="$(repo_owner)"
    fi
  fi

  if ! repo_exists "$owner"; then
    die "repository ${owner}/${REPO_NAME} does not exist"
  fi

  validate_deletable "$owner"

  echo "forge-test-repo: deleting ${owner}/${REPO_NAME}..."
  gh repo delete "${owner}/${REPO_NAME}" --yes

  rm -f "$STATE_FILE"
  echo "forge-test-repo: deleted ${owner}/${REPO_NAME}"
}

cmd_info() {
  require_gh
  local owner
  owner="$(repo_owner)"
  if ! repo_exists "$owner"; then
    echo "No ${owner}/${REPO_NAME} repository on GitHub."
    if [[ -f "$STATE_FILE" ]]; then
      echo "(stale state file at ${STATE_FILE})"
    fi
    return 0
  fi

  gh repo view "${owner}/${REPO_NAME}" --json name,description,url,visibility \
    --jq '"\(.name) (\(.visibility))\n\(.url)\n\(.description)"'

  if [[ -f "$STATE_FILE" ]]; then
    echo
    echo "Local state (${STATE_FILE}):"
    cat "$STATE_FILE"
  fi
}

usage() {
  cat <<'EOF'
Usage: scripts/forge-test-repo <command>

Commands:
  create   Create forge-manual-test with example Feature + sub-issues (fails if repo exists)
  delete   Delete forge-manual-test after safety checks (name + description)
  info     Show remote repo and local state file

EOF
}

main() {
  local cmd="${1:-}"
  case "$cmd" in
    create) cmd_create ;;
    delete) cmd_delete "${2:-}" ;;
    info) cmd_info ;;
    -h|--help|help|'') usage ;;
    *) die "unknown command: ${cmd} (try --help)" ;;
  esac
}

main "$@"
